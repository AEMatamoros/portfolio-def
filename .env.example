# Public configuration. Vite inlines every VITE_* variable into the browser
# bundle, so this is not a secret and must never hold one.
#
# Endpoint that receives contact form messages. The form sends a POST with the
# JSON body { "html": "..." } and expects a 2xx response on success.
# Leave it empty to show a mailto fallback instead of the form.
#
# For local testing copy this file to .env.local (git ignores *.local).
# Set it for Production and Preview in the hosting dashboard before deploying.
VITE_CONTACT_API_URL=
